# OpenRouter Configuration (Used for LLM Agent Orchestration)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL_COPILOT=tencent/hunyuan
OPENROUTER_MODEL_SPR=tencent/hunyuan
OPENROUTER_MODEL_REDTEAM=tencent/hunyuan
OPENROUTER_MODEL_EXPLAIN=qwen/qwen-2.5-72b-instruct
OPENROUTER_MODEL_REPORT=qwen/qwen-2.5-72b-instruct

# Agent Execution Limits
MAX_AGENT_ITERATIONS=3
MAX_TOOL_CALLS_PER_RUN=20
AGENT_TIMEOUT_SECONDS=45
SAFE_MODE_FALLBACK=true

# Engine & Network Parameters
OPENROUTER_TIMEOUT=30
OPENROUTER_MAX_RETRIES=2
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_TOP_P=0.9

# Administrator Credentials (Used for Initial Seeding & Access Control)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password_here

# SMTP Configuration (Optional — Used for Real-Time Email Dispatch)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_FROM=notifications@example.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
MAIL_FROM_NAME=UrjaNetra AI Command Platform
